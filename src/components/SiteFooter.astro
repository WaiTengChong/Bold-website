---
import Icon from "@/components/Icon.astro";
import { withBase } from "@/lib/utils";
---

<footer class="w-full border-t border-outline-variant/30 bg-tertiary text-on-tertiary">
  <div class="mx-auto grid w-full max-w-container-max grid-cols-1 gap-gutter px-margin-mobile py-stack-xl md:grid-cols-4 md:px-margin-desktop">
    <div class="md:col-span-2">
      <div class="mb-stack-md font-display text-headline-lg-mobile uppercase text-on-tertiary md:text-display-md">BOLD</div>
      <p class="mb-stack-md max-w-sm font-sans text-body-md font-light text-on-tertiary-container" data-i18n="footer.tagline">
        The premier destination for elite athletes and discerning enthusiasts. Redefining the standard of pickleball
        hospitality.
      </p>
      <div class="flex gap-4 text-on-tertiary-container/60" aria-hidden="true">
        <Icon name="globe" class="size-6" />
        <Icon name="at" class="size-6" />
      </div>
    </div>
    <div>
      <h3 class="mb-4 font-sans text-label-md font-medium text-on-tertiary" data-i18n="footer.explore">Explore</h3>
      <nav class="flex flex-col gap-2.5" aria-label="Explore">
        <a class="font-sans text-body-md font-light text-on-tertiary-container transition-colors hover:text-on-tertiary" href={withBase("/")} data-i18n="footer.club">The Club</a>
        <a class="font-sans text-body-md font-light text-on-tertiary-container transition-colors hover:text-on-tertiary" href={withBase("/membership")} data-i18n="footer.membership">Membership</a>
        <a class="font-sans text-body-md font-light text-on-tertiary-container transition-colors hover:text-on-tertiary" href={withBase("/#events")} data-i18n="footer.programs">Programs</a>
        <a class="font-sans text-body-md font-light text-on-tertiary-container transition-colors hover:text-on-tertiary" href={withBase("/news")} data-i18n="footer.news">Club News</a>
      </nav>
    </div>
    <div>
      <h3 class="mb-4 font-sans text-label-md font-medium text-on-tertiary" data-i18n="footer.legal">Legal</h3>
      <p class="font-sans text-body-md font-light text-on-tertiary-container/80" data-i18n="footer.legalNote">Legal and privacy pages coming soon.</p>
    </div>
  </div>
  <div class="border-t border-on-tertiary/10 px-margin-mobile py-6 md:px-margin-desktop">
    <p class="font-sans text-label-sm text-on-tertiary-container/70" data-i18n="footer.copyright">
      © 2026 BOLD PICKLEBALL. ALL RIGHTS RESERVED.
    </p>
  </div>
</footer>
