---
import { withBase } from "@/lib/utils";
---

<section id="membership" class="border-y border-outline-variant/40 bg-surface-container-low py-stack-lg md:py-stack-xl">
  <div class="mx-auto grid max-w-container-max grid-cols-1 items-center gap-stack-lg px-margin-mobile md:grid-cols-2 md:gap-gutter md:px-margin-desktop">
    <div class="min-w-0">
      <h2 class="mb-stack-md font-display text-[clamp(2.25rem,8vw,3.5rem)] uppercase leading-none text-primary">
        <span data-i18n="membership.title1">THE BOLD</span>
        <br />
        <span data-i18n="membership.title2">MEMBERSHIP</span>
      </h2>
      <p class="max-w-md font-sans text-body-md font-light text-on-surface-variant" data-i18n="membership.eyebrow">
        EXCLUSIVITY REIMAGINED
      </p>
    </div>
    <div class="min-w-0 border-l border-primary/20 pl-6 md:pl-10">
      <ul class="mb-stack-md space-y-3 font-sans text-body-md font-light text-on-surface md:text-body-lg">
        <li data-i18n="membership.perk1">UNLIMITED COURT ACCESS</li>
        <li data-i18n="membership.perk2">24/7 ADVANCED RECOVERY SUITE</li>
        <li data-i18n="membership.perk3">CONCIERGE EQUIPMENT SERVICE</li>
        <li data-i18n="membership.perk4">PRIVATE COACHING PREFERENCE</li>
      </ul>
      <a href={withBase("/membership")} class="bold-btn-primary" data-i18n="membership.cta">
        INQUIRE NOW
      </a>
    </div>
  </div>
</section>
