---
import type { GalleryImage } from "@/lib/photos";
import { HOMEPAGE_GALLERY } from "@/lib/photos";

interface Props {
  title?: string;
  handle?: string;
  images?: GalleryImage[];
}

const {
  title = "BOLD LIFE",
  handle = "@BOLDPICKLEBALL",
  images = HOMEPAGE_GALLERY,
} = Astro.props;
---

<section id="life" class="py-stack-lg">
  <div class="mb-stack-md flex flex-col gap-2 px-margin-mobile sm:flex-row sm:items-center sm:justify-between md:px-margin-desktop">
    <h2 class="font-display text-headline-lg-mobile uppercase text-primary md:text-headline-lg">{title}</h2>
    <span class="truncate font-sans text-[10px] font-semibold uppercase text-on-surface-variant sm:text-label-sm">{handle}</span>
  </div>
  <div class="grid grid-cols-3 gap-0.5 px-0.5 sm:gap-1 sm:px-1">
    {images.map((image) => (
      <div class="aspect-square overflow-hidden bg-surface-container-high">
        <img
          src={image.src}
          alt={image.alt}
          class="h-full w-full object-cover grayscale"
          style={image.objectPosition ? `object-position: ${image.objectPosition}` : undefined}
          width="800"
          height="800"
          loading="lazy"
        />
      </div>
    ))}
  </div>
</section>
