---
import AuthForm from "@/components/react-islands/AuthForm";

interface Props {
  mode: "login" | "signup";
  eyebrow: string;
  title: string;
  subtitle: string;
}

const { mode, eyebrow, title, subtitle } = Astro.props;
---

<section class="mx-auto flex min-h-[70vh] max-w-container-max items-center justify-center px-margin-mobile py-stack-xl md:px-margin-desktop">
  <div class="auth-panel w-full max-w-md border border-outline-variant/40 bg-surface-container-lowest p-margin-mobile md:p-10">
    <span class="mb-3 block font-sans text-label-sm font-semibold uppercase tracking-[0.4em] text-on-surface-variant">
      {eyebrow}
    </span>
    <h1 class="mb-2 font-display text-display-md uppercase text-primary">{title}</h1>
    <p class="mb-stack-md font-sans text-body-md font-light text-on-surface-variant">{subtitle}</p>
    <AuthForm client:load mode={mode} />
  </div>
</section>
