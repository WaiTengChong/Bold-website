---
import Icon from "@/components/Icon.astro";

const items = [
  { key: "values.play", icon: "activity" as const },
  { key: "values.train", icon: "dumbbell" as const },
  { key: "values.recover", icon: "heart" as const },
  { key: "values.connect", icon: "users" as const },
  { key: "values.belong", icon: "award" as const },
];
---

<section class="overflow-hidden whitespace-nowrap border-y border-outline-variant/30 bg-surface-container py-3" aria-label="Brand values">
  <div class="flex w-max animate-bold-scroll">
    {[0, 1].map((copy) => (
      <div class="flex items-center gap-stack-lg px-margin-desktop" aria-hidden={copy === 1 ? "true" : undefined}>
        {items.map(({ key, icon }) => (
          <>
            <span class="font-display text-headline-lg-mobile text-primary opacity-20 md:text-display-md" data-i18n={key}>{key}</span>
            <Icon name={icon} class="size-8 text-primary" />
          </>
        ))}
      </div>
    ))}
  </div>
</section>
