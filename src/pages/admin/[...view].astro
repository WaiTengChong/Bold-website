---
import "@/styles/global.css";
import AdminDashboard from "@/components/react-islands/AdminDashboard";
import { withBase } from "@/lib/utils";

const VIEWS = ["dashboard", "schedule", "members", "inventory", "settings"] as const;
type ViewId = (typeof VIEWS)[number];

export function getStaticPaths() {
  return [
    { params: { view: undefined } },
    { params: { view: "schedule" } },
    { params: { view: "members" } },
    { params: { view: "inventory" } },
    { params: { view: "settings" } },
  ];
}

const raw = Astro.params.view;
const view: ViewId = !raw || raw === "dashboard" ? "dashboard" : (raw as ViewId);
const titles: Record<ViewId, string> = {
  dashboard: "Dashboard",
  schedule: "Schedule",
  members: "Members",
  inventory: "Inventory",
  settings: "Settings",
};
---

<!doctype html>
<html class="light" lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="BOLD Pickleball admin console. Staff access only." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <title>BOLD PICKLEBALL | {titles[view]}</title>
  </head>
  <body class="h-dvh max-w-full overflow-hidden bg-surface text-on-surface">
    <AdminDashboard client:load view={view} />
  </body>
</html>
