---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AuthPanel from "@/components/AuthPanel.astro";
---

<BaseLayout
  title="BOLD PICKLEBALL | Log In"
  description="Log in to your BOLD Pickleball account to book courts and manage membership."
>
  <main>
    <AuthPanel
      mode="login"
      eyebrow="Members"
      title="Log In"
      subtitle="Enter your phone number and password to access court booking."
    />
  </main>
</BaseLayout>
