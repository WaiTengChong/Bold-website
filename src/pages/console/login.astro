---
import "@/styles/global.css";
import ConsoleAuthPanel from "@/components/react-islands/ConsoleAuthPanel";
import LanguageToggle from "@/components/react-islands/LanguageToggle";
import { withBase } from "@/lib/utils";
---

<!doctype html>
<html class="light" lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>BOLD PICKLEBALL | Staff sign in</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-dvh overflow-x-clip bg-surface text-on-surface pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))]" data-form-focus="true">
  <main class="cut-surface-page cut-surface-page--auth flex min-h-dvh flex-col">
    <div class="mb-4 flex justify-end">
      <LanguageToggle client:load />
    </div>
    <div class="cut-surface-layout cut-surface-layout--auth my-auto w-full">
      <div class="auth-panel auth-panel--split auth-panel--console">
        <ConsoleAuthPanel client:load />
      </div>
    </div>
  </main>
  </body>
</html>