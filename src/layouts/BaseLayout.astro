---
import "@/styles/global.css";
import SiteHeader from "@/components/react-islands/SiteHeader";
import SiteFooter from "@/components/SiteFooter.astro";
import MobileChrome from "@/components/react-islands/MobileChrome";
import I18nBoot from "@/components/react-islands/I18nBoot";
import { withBase } from "@/lib/utils";

interface Props {
  title: string;
  description: string;
  /** Form-heavy member/auth pages: hide mobile FAB/bar padding. */
  formFocus?: boolean;
}

const { title, description, formFocus = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body
    class:list={[
      "overflow-x-hidden bg-surface text-on-surface",
      formFocus
        ? "pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))] md:pb-0"
        : "pb-[calc(5rem+env(safe-area-inset-bottom,0px))] md:pb-0",
    ]}
    data-form-focus={formFocus ? "true" : undefined}
  >
    <I18nBoot client:load />
    <SiteHeader client:load />
    <slot />
    <SiteFooter />
    {!formFocus && <MobileChrome client:load />}
  </body>
</html>
